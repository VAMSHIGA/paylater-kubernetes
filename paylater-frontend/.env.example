# PayLater Frontend — environment template
# Copy to .env.local for local development:
#   cp .env.example .env.local

# API base URL for local development (Vite proxies /api → http://localhost:8080)
VITE_API_BASE_URL=/api

# Production / direct gateway access (set at build time if not using a reverse proxy):
# VITE_API_BASE_URL=http://localhost:8080
