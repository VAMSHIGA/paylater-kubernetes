# Reporting Service — environment variables (scaffold).
# Copy to .env for local development. Do not commit secrets.

# HTTP server
HTTP_PORT=8086

# Application environment
APP_ENV=development

# MySQL (Reporting read-model database — not the monolith database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=report_db

# JWT validation (must match Identity Service / monolith during migration)
JWT_SECRET=change_me_to_strong_random_secret
