# Identity Service — environment variables for local development / admin-bootstrap.
# Copy to .env for local development. Do not commit secrets.
#
# When PayLater runs in Docker Compose, admin-bootstrap on the host must use the
# published MySQL port from docker-compose.dev.yml (default 3308), NOT a local
# MySQL on 3306. Inside containers, Compose sets DB_HOST=mysql and DB_PORT=3306.

HTTP_PORT=8081

DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=identity_db

JWT_SECRET=change_me_to_strong_random_secret
