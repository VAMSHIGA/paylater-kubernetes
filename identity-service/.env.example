# Identity Service — environment variables (scaffold).
# Copy to .env for local development. Do not commit secrets.

# HTTP server
HTTP_PORT=8081

# Application environment
APP_ENV=development

# MySQL (Identity-owned database — not the monolith database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=identity_db

# JWT signing (must match validators in monolith/gateway during migration)
JWT_SECRET=change_me_to_strong_random_secret
JWT_EXPIRY=24h
