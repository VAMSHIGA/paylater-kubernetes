# PayLater — Docker Compose environment template
# Copy to .env and replace placeholder values before running:
#   cp .env.example .env

# MySQL root password (required)
# Used by: mysql container, healthcheck, and DB_PASSWORD for all microservices
MYSQL_ROOT_PASSWORD=your-mysql-root-password

# JWT signing secret (required)
# Use a long random string; must match across all six microservices
JWT_SECRET=your-jwt-secret-key

# MySQL application user for microservices (optional, default: root)
DB_USER=root

# Host port published for MySQL (optional, default: 3306)
MYSQL_PORT=3306
